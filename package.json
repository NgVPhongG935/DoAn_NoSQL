{
  "name": "rideflow-cassandra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:p1": "node scripts/verify-p1.mjs",
    "test": "node --import ./tests/register.mjs --test tests/security.test.mjs tests/business.test.mjs tests/demo.test.mjs tests/admin-accounts.test.mjs tests/customer-password-reset.test.mjs tests/driver-registration.test.mjs tests/admin-support.test.mjs tests/admin-payments.test.mjs tests/admin-trips.test.mjs tests/text-encoding.test.mjs tests/localized-search.test.mjs tests/maps.test.mjs tests/travel-time.test.mjs tests/payments-reviews.test.mjs tests/payment-history.test.mjs tests/trip-notifications.test.mjs",
    "test:business": "node --import ./tests/register.mjs --test tests/business.test.mjs",
    "test:business:browser": "node --test tests/browser-business.test.mjs",
    "test:security": "node --import ./tests/register.mjs --test tests/security.test.mjs",
    "test:security:journal": "node scripts/test-journal-security.mjs",
    "test:security:production": "node --test tests/production-security.test.mjs",
    "db:inspect": "node scripts/inspect-cassandra-schema.mjs",
    "db:repair:vietnamese": "node scripts/repair-vietnamese-text.mjs",
