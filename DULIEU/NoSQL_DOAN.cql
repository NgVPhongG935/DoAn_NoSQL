CREATE KEYSPACE IF NOT EXISTS dat_xe_cong_nghe
WITH replication = {
    'class': 'SimpleStrategy',
    'replication_factor': 1
};

USE dat_xe_cong_nghe;
CREATE TABLE IF NOT EXISTS customers (
    customer_id uuid PRIMARY KEY,
    full_name text,
    phone text,
    email text,
    password text,
    created_at timestamp,
    status text
);

CREATE TABLE IF NOT EXISTS drivers (
    driver_id uuid PRIMARY KEY,
    full_name text,
    phone text,
    email text,
    password text,
    license_number text,
    rating double,
    driver_status text,
    account_status text,
    created_at timestamp
);

CREATE TABLE IF NOT EXISTS vehicles (
    vehicle_id uuid PRIMARY KEY,
    driver_id uuid,
    license_plate text,
    vehicle_type text,
    brand text,
    model text,
    color text,
    seat_count int,
    status text
);

CREATE TABLE IF NOT EXISTS service_types (
    service_id uuid PRIMARY KEY,
    service_name text,
    base_fare decimal,
    price_per_km decimal,
    description text,
    status text
    );
    CREATE TABLE IF NOT EXISTS trips_by_id (
    trip_id uuid PRIMARY KEY,
    customer_id uuid,
    driver_id uuid,
    vehicle_id uuid,
    service_id uuid,
    pickup_address text,
    destination_address text,
    distance_km double,
    estimated_fare decimal,
    final_fare decimal,
    booked_at timestamp,
    started_at timestamp,
    completed_at timestamp,
    status text,
    payment_method text
    ); 
    CREATE TABLE IF NOT EXISTS trips_by_customer (
    customer_id uuid,
    booked_at timestamp,
    trip_id uuid,
    driver_id uuid,
    pickup_address text,
    destination_address text,
    final_fare decimal,
    status text,
    PRIMARY KEY (customer_id, booked_at, trip_id)
) WITH CLUSTERING ORDER BY (booked_at DESC);
CREATE TABLE IF NOT EXISTS trips_by_driver (
    driver_id uuid,
    booked_at timestamp,
    trip_id uuid,
    customer_id uuid,
    pickup_address text,
    destination_address text,
    final_fare decimal,
    status text,
    PRIMARY KEY (driver_id, booked_at, trip_id)
) WITH CLUSTERING ORDER BY (booked_at DESC);
CREATE TABLE IF NOT EXISTS trips_by_status (
    status text,
    trip_date date,
    booked_at timestamp,
    trip_id uuid,
    customer_id uuid,
    driver_id uuid,
    pickup_address text,
    destination_address text,
    final_fare decimal,
    PRIMARY KEY ((status, trip_date), booked_at, trip_id)
) WITH CLUSTERING ORDER BY (booked_at DESC);
USE dat_xe_cong_nghe;

-- 9. Lịch sử trạng thái chuyến đi
CREATE TABLE IF NOT EXISTS trip_status_history (
    trip_id uuid,
    changed_at timestamp,
    status text,
    note text,
    PRIMARY KEY (trip_id, changed_at)
) WITH CLUSTERING ORDER BY (changed_at DESC);

-- 10. Thanh toán theo chuyến
CREATE TABLE IF NOT EXISTS payments_by_trip (
    trip_id uuid,
    payment_id uuid,
    customer_id uuid,
    amount decimal,
    payment_method text,
    payment_status text,
    paid_at timestamp,
    PRIMARY KEY (trip_id, payment_id)
);

-- 11. Lịch sử thanh toán theo khách hàng
CREATE TABLE IF NOT EXISTS payments_by_customer (
    customer_id uuid,
    paid_at timestamp,
    payment_id uuid,
    trip_id uuid,
    amount decimal,
    payment_method text,
    payment_status text,
    PRIMARY KEY (customer_id, paid_at, payment_id)
) WITH CLUSTERING ORDER BY (paid_at DESC);

-- 12. Đánh giá theo chuyến
CREATE TABLE IF NOT EXISTS reviews_by_trip (
    trip_id uuid PRIMARY KEY,
    review_id uuid,
    customer_id uuid,
    driver_id uuid,
    rating int,
    comment text,
    created_at timestamp
);

-- 13. Đánh giá theo tài xế
CREATE TABLE IF NOT EXISTS reviews_by_driver (
    driver_id uuid,
    created_at timestamp,
    review_id uuid,
    trip_id uuid,
    customer_id uuid,
    rating int,
    comment text,
    PRIMARY KEY (driver_id, created_at, review_id)
) WITH CLUSTERING ORDER BY (created_at DESC);

-- 14. Voucher
CREATE TABLE IF NOT EXISTS vouchers (
    voucher_code text PRIMARY KEY,
    voucher_name text,
    discount_type text,
    discount_value decimal,
    max_discount decimal,
    min_trip_amount decimal,
    start_date timestamp,
    end_date timestamp,
    quantity int,
    status text
);

-- 15. Voucher của khách hàng
CREATE TABLE IF NOT EXISTS customer_vouchers (
    customer_id uuid,
    voucher_code text,
    received_at timestamp,
    used_at timestamp,
    status text,
    PRIMARY KEY (customer_id, voucher_code)
);

-- 16. Khiếu nại theo khách hàng
CREATE TABLE IF NOT EXISTS complaints_by_customer (
    customer_id uuid,
    created_at timestamp,
    complaint_id uuid,
    trip_id uuid,
    subject text,
    content text,
    status text,
    resolved_at timestamp,
    PRIMARY KEY (customer_id, created_at, complaint_id)
) WITH CLUSTERING ORDER BY (created_at DESC);

-- 17. Thông báo theo người dùng
CREATE TABLE IF NOT EXISTS notifications_by_user (
    user_id uuid,
    created_at timestamp,
    notification_id uuid,
    title text,
    content text,
    notification_type text,
    is_read boolean,
    PRIMARY KEY (user_id, created_at, notification_id)
) WITH CLUSTERING ORDER BY (created_at DESC);

-- 18. Doanh thu tài xế theo tháng
CREATE TABLE IF NOT EXISTS driver_revenue_by_month (
    driver_id uuid,
    year_month text,
    trip_date date,
    trip_id uuid,
    fare decimal,
    PRIMARY KEY ((driver_id, year_month), trip_date, trip_id)
) WITH CLUSTERING ORDER BY (trip_date DESC);

-- 19. Chi tiêu khách hàng theo tháng
CREATE TABLE IF NOT EXISTS customer_spending_by_month (
    customer_id uuid,
    year_month text,
    trip_date date,
    trip_id uuid,
    amount decimal,
    PRIMARY KEY ((customer_id, year_month), trip_date, trip_id)
) WITH CLUSTERING ORDER BY (trip_date DESC);
USE dat_xe_cong_nghe;

