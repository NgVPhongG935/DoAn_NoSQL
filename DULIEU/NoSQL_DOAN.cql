-- KIEM TRA
SELECT COUNT(*) FROM customers;
SELECT COUNT(*) FROM drivers;
SELECT COUNT(*) FROM trips_by_id;
SELECT COUNT(*) FROM payments_by_trip;
SELECT COUNT(*) FROM reviews_by_trip;
SELECT COUNT(*) FROM customers;
SELECT COUNT(*) FROM drivers;
SELECT COUNT(*) FROM trips_by_id;
SELECT COUNT(*) FROM payments_by_trip;
SELECT COUNT(*) FROM reviews_by_trip;
SELECT COUNT(*) FROM customers;
SELECT * FROM customers LIMIT 10;
SELECT * FROM drivers LIMIT 10;
SELECT * FROM vehicles LIMIT 10;
SELECT * FROM service_types;
SELECT * FROM trips_by_id LIMIT 10;
SELECT * FROM vouchers LIMIT 10;

SELECT *
FROM trips_by_customer
WHERE customer_id = 511a85ec-7143-4a74-b09e-e3aca356ce71;

SELECT *
FROM trips_by_customer
WHERE customer_id = 511a85ec-7143-4a74-b09e-e3aca356ce71
AND booked_at >= '2026-07-01'
AND booked_at < '2026-09-01';

SELECT *
FROM trips_by_customer
WHERE customer_id = 511a85ec-7143-4a74-b09e-e3aca356ce71;

SELECT *
FROM trips_by_customer
WHERE customer_id = 511a85ec-7143-4a74-b09e-e3aca356ce71
AND booked_at >= '2026-07-01'
AND booked_at < '2026-09-01';

SELECT driver_id, full_name
FROM drivers
LIMIT 1;

SELECT *
FROM trips_by_driver
WHERE driver_id = 39d338c4-e0aa-4a40-881b-c5dd831dd7d5;

SELECT *
FROM trips_by_driver
WHERE driver_id = 39d338c4-e0aa-4a40-881b-c5dd831dd7d5
AND booked_at >= '2026-07-01'
AND booked_at < '2026-09-01';

SELECT *
FROM reviews_by_driver
WHERE driver_id = 39d338c4-e0aa-4a40-881b-c5dd831dd7d5;

SELECT *
FROM driver_revenue_by_month
WHERE driver_id = 39d338c4-e0aa-4a40-881b-c5dd831dd7d5
AND year_month = '2026-07';

SELECT *
FROM payments_by_customer
WHERE customer_id = 511a85ec-7143-4a74-b09e-e3aca356ce71;

SELECT *
FROM customer_spending_by_month
WHERE customer_id = 511a85ec-7143-4a74-b09e-e3aca356ce71
AND year_month = '2026-07';

CREATE TABLE IF NOT EXISTS customers_import_test (
    customer_id uuid PRIMARY KEY,
    full_name text,
    phone text,
    email text,
    password text,
    created_at timestamp,
    status text
);
