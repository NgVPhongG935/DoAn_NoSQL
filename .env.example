CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=dat_xe_cong_nghe
CASSANDRA_CONSISTENCY=localOne
# Enable only after migration 002 is approved/applied and SERIAL/QUORUM are tested.
RIDEFLOW_BUSINESS_JOURNAL_ENABLED=false
# Generate a fresh key: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Required in every environment. Blank/weak/placeholder values prevent startup.
JWT_SECRET=
# Admin login is disabled until both values below are configured. No built-in password.
ADMIN_EMAIL=admin@rideflow.vn
# Generate using scripts/hash-admin-password.mjs --dotenv; dollar signs must be escaped in .env.local.
ADMIN_PASSWORD_HASH=
# Every authenticated ADMIN has full administrative access. No permission list required.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
